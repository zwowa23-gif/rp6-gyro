# Runtime image for rp6imu (libssc needs these shared libraries; the binary itself is mounted from the install dir)
FROM docker.io/library/debian:trixie-slim
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends libqmi-glib5 libprotobuf-c1 libglib2.0-0t64 \
    && rm -rf /var/lib/apt/lists/*
