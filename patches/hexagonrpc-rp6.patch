index bd9f353..9e7e4d6 100644
--- a/hexagonrpcd/hexagonfs.c
+++ b/hexagonrpcd/hexagonfs.c
@@ -26,6 +26,8 @@
 #include <stdlib.h>
 #include <string.h>
 #include <sys/types.h>
+#include <unistd.h>
+#include <dirent.h>
 
 #include "hexagonfs.h"
 
@@ -277,3 +279,62 @@ int hexagonfs_fstat(struct hexagonfs_fd **fds, int fileno, struct stat *stats)
 
 	return fd->ops->stat(fd, stats);
 }
+
+/* Layout must match struct mapped_ctx in hexagonfs_mapped.c */
+struct adopted_ctx {
+	int fd;
+	DIR *dir;
+};
+
+/* Wrap an already-open host file so it can be read/seeked/closed through the normal mapped ops */
+int hexagonfs_adopt_real_fd(struct hexagonfs_fd **fds, int realfd)
+{
+	struct adopted_ctx *ctx;
+	struct hexagonfs_fd *fd;
+	int ret;
+
+	ctx = malloc(sizeof(*ctx));
+	fd = malloc(sizeof(*fd));
+	if (ctx == NULL || fd == NULL) {
+		free(ctx);
+		free(fd);
+		return -ENOMEM;
+	}
+
+	ctx->fd = realfd;
+	ctx->dir = NULL;
+	fd->is_assigned = false;
+	fd->up = NULL;
+	fd->ops = &hexagonfs_mapped_ops;
+	fd->data = ctx;
+
+	ret = allocate_file_number(fds, fd);
+	if (ret < 0) {
+		free(ctx);
+		free(fd);
+	}
+
+	return ret;
+}
+
+ssize_t hexagonfs_write(struct hexagonfs_fd **fds, int fileno, size_t size, const void *ptr)
+{
+	struct hexagonfs_fd *fd;
+	struct adopted_ctx *ctx;
+
+	if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD)
+		return -EBADF;
+
+	fd = fds[fileno];
+	if (fd == NULL || fd->ops != &hexagonfs_mapped_ops)
+		return -EBADF;
+
+	ctx = fd->data;
+	if (ctx->dir != NULL)
+		return -EISDIR;
+
+	if (write(ctx->fd, ptr, size) < 0)
+		return -errno;
+
+	return size;
+}
