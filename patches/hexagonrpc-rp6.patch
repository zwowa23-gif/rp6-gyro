+/* Directory for files the DSP wants to create (registry regeneration); HEXAGONRPCD_WRITE_DIR or /tmp/hexagonrpcd-write */
+static const char *write_dir(void)
+{
+	const char *d = getenv("HEXAGONRPCD_WRITE_DIR");
+
+	return d != NULL ? d : "/tmp/hexagonrpcd-write";
+}
+
+/* Resolve "." and ".." lexically; result is a relative path inside write_dir(), or -1 if it would escape */
+static int write_path(const char *virt, char *out, size_t outsz)
+{
+	char tmp[1024];
+	char *seg, *save, *parts[64];
+	size_t n = 0, i, len = 0;
+
+	if (strlen(virt) >= sizeof(tmp))
+		return -1;
+	strcpy(tmp, virt);
+
+	for (seg = strtok_r(tmp, "/", &save); seg != NULL; seg = strtok_r(NULL, "/", &save)) {
+		if (!strcmp(seg, ".") || !*seg)
+			continue;
+		if (!strcmp(seg, "..")) {
+			if (n == 0)
+				return -1;
+			n--;
+			continue;
+		}
+		if (n >= 64)
+			return -1;
+		parts[n++] = seg;
+	}
+	if (n == 0)
+		return -1;
+
+	out[0] = 0;
+	for (i = 0; i < n; i++) {
+		len += snprintf(out + len, outsz - len, "%s%s", i ? "/" : "", parts[i]);
+		if (len >= outsz)
+			return -1;
+	}
+	return 0;
+}
+
+static int open_write_file(const char *virt, char mode, bool create)
+{
+	char rel[1024], full[2048], *p;
+	int flags;
+
+	if (write_path(virt, rel, sizeof(rel)))
+		return -EINVAL;
+	snprintf(full, sizeof(full), "%s/%s", write_dir(), rel);
+
+	if (create) {
+		for (p = full + strlen(write_dir()) + 1; *p; p++) {
+			if (*p == '/') {
+				*p = 0;
+				mkdir(full, 0755);
+				*p = '/';
+			}
+		}
+		flags = O_RDWR | O_CREAT | (mode == 'a' ? O_APPEND : O_TRUNC);
+	} else {
+		flags = O_RDONLY;
+	}
+
+	int fd = open(full, flags, 0644);
+	return fd < 0 ? -errno : fd;
+}
